        {
          "id": 18,
          "name": "Ball",
          "visible": true,
          "locked": false,
          "opacity": 1.0,
          "clip": false,
          "bone": null,
          "body": {
            "kind": "Dynamic",
            "restitution": 0.55,
            "friction": 0.2,
            "gravity_scale": 1.0
          },
          "script": "fn on_init(me) {\n    set_global(\"visits\", get_global(\"visits\") + 1);\n    print(\"Arrow keys roll the ball, Space jumps, R resets it, Escape goes back to the title (visit \" + get_global(\"visits\") + \").\");\n    play(\"Idle\", true); // the sun, stars and tentacle keep moving\n}\n\nfn on_update(me, dt) {\n    let speed = 260.0;\n    if key_down(\"Left\")  { set_velocity(me, -speed, velocity_y(me)); }\n    if key_down(\"Right\") { set_velocity(me,  speed, velocity_y(me)); }\n    if pos_y(me) > 800.0 { set_pos(me, 900.0, 40.0); set_velocity(me, 0.0, 0.0); }\n}\n\nfn on_input(me, key) {\n    if key == \"Space\" { add_impulse(me, 0.0, -450.0); }\n    if key == \"R\"     { set_pos(me, 900.0, 40.0); set_velocity(me, 0.0, 0.0); }\n    if key == \"Escape\" { load_scene(\"Title\"); }\n}\n\nfn on_collision(me, other) {\n    set_var(me, \"bounces\", get_var(me, \"bounces\") + 1);\n}",
          "transform": [
            1.0,
            0.0,
            0.0,
            1.0,
            900.0,
            40.0
          ],
